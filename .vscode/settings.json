{
	"rust-analyzer.procMacro.enable": true,
	"todo-tree.general.tags": [
		"BUG",
		"HACK",
		"FIXME",
		"TODO",
		"XXX",
		"todo!"
	],
	"todo-tree.regex.regex": "(($TAGS)|^\\s*- \\[ \\])",
	"rust-analyzer.cargo.allFeatures": true,
	"rust-analyzer.cargo.buildScripts.enable": true,
	"cSpell.words": [
		"adler",
		"ansi",
		"ascii",
		"asteracea",
		"binstall",
		"bitbucket",
		"github",
		"gitlab",
		"preprocess",
		"punct",
		"Punct",
		"RUSTSEC",
		"Schichler",
		"Tamme"
	]
}